#Q20. Find the Longest Word That Appears Only Once
def longest_unique_word(sentence):
    words = sentence.lower().split()
    frequency = {}
    for word in words:
        if word in frequency:
            frequency[word] += 1
        else:
            frequency[word] = 1
    longest = ""
    for word in words:
        if frequency[word] == 1:
            if len(word) > len(longest):
                longest = word
    return longest
sentence = "Python makes coding useful Python"
print(longest_unique_word(sentence))
